{
  "opencollection": "1.0.0",
  "info": {
    "name": "Leaf Agriculture Leaf API Reference > Alerts API Reference > Leaf Link > API Key API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "API Reference > Leaf Link > API Key",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Leaf Agriculture Get all Leaf User API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/services/usermanagement/api/api-keys",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer {{leaf_token}}"
              }
            ],
            "params": [
              {
                "name": "leafUserId",
                "value": "{{leaf_user_id}}",
                "type": "query"
              }
            ]
          },
          "docs": "Leaf Agriculture Get all Leaf User API keys"
        },
        {
          "info": {
            "name": "Leaf Agriculture Create a Leaf User API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/services/usermanagement/api/api-keys",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer {{leaf_token}}"
              }
            ]
          },
          "docs": "Leaf Agriculture Create a Leaf User API key"
        },
        {
          "info": {
            "name": "Leaf Agriculture Revoke a Leaf User API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/services/usermanagement/api/api-keys/:api_key_id",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer {{leaf_token}}"
              }
            ],
            "params": [
              {
                "name": "api_key_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Leaf Agriculture Revoke a Leaf User API key"
        }
      ]
    }
  ],
  "bundled": true
}